# NooblyJS Core — example environment. Copy to .env and fill in values.
# Never commit your real .env.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=11000

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated API keys (required in production; auto-generated in development).
NOOBLYJS_API_KEYS=
# Master secret for the encrypted settings file (falls back to SESSION_SECRET).
SETTINGS_SECRET=

# ── Deployment ──────────────────────────────────────────────────────────────
# Set behind a TLS-terminating proxy/load balancer so secure session cookies work
# ("1" = trust one hop, "true" = trust all, or a subnet list).
TRUST_PROXY=
# Shared session store for restarts / multiple replicas (otherwise in-process).
SESSION_REDIS_URL=
# SESSION_REDIS_PREFIX=sess:
# Where the filing service stores uploads (default ./.application/files).
FILING_BASE_DIR=
# Graceful shutdown watchdog.
# SHUTDOWN_TIMEOUT_MS=15000

# ── HTTPS (optional; generate dev certs with `npm run certs`) ───────────────
HTTPS_ENABLED=false
# HTTPS_KEY_PATH=./certs/server.key
# HTTPS_CERT_PATH=./certs/server.crt
# HTTPS_CA_PATH=
# HTTPS_PASSPHRASE=
# HTTP_REDIRECT_PORT=

# ── Security tuning ─────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated); same-origin only when empty.
CORS_ORIGINS=
# Max JSON/urlencoded body size.
# BODY_LIMIT=1mb
# Max upload size in bytes when the filing provider sets none (default 10 MB).
# FILING_MAX_FILE_SIZE=10485760
# Content-Security-Policy: enforce (default) | report-only | off
# CSP_MODE=enforce
# Extra origins for scripts/styles/images/connections, space-separated.
# CSP_EXTRA_SOURCES=
# Login throttling.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_LOCK_THRESHOLD=5
# LOGIN_LOCK_WINDOW_MS=900000
# LOGIN_LOCK_MS=900000
# BCRYPT_COST=12
# Initial admin password (otherwise generated and written to .application/data).
# DEFAULT_ADMIN_PASSWORD=
# Max documents per /searching/api/add-bulk request.
# SEARCH_MAX_BULK_DOCUMENTS=1000

# ── AI providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Single sign-on / OAuth (optional) ───────────────────────────────────────
# SSO_SECRET=
# SSO_ALLOWED_RETURN_URLS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_SECRET=
# AZURE_AD_REDIRECT_URL=
# AZURE_AD_BASE_URL=

# ── Cloud providers (only for the matching cache/queue/filing providers) ───
# REDIS_URL=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ELASTICACHE_ENDPOINT=
# ELASTICACHE_PORT=
# ELASTICACHE_AUTH_TOKEN=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_REDIS_HOSTNAME=
# AZURE_REDIS_PORT=
# AZURE_REDIS_ACCESS_KEY=
# GCP_PROJECT_ID=
# GCP_REGION=
# GCP_REDIS_HOST=
# GCP_REDIS_PORT=
# GCP_REDIS_AUTH_TOKEN=
