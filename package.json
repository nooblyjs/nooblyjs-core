{
  "name": "nooblyjs-core",
  "version": "1.0.10",
  "description": "A powerful set of modular Node.js backend services with singleton pattern - caching, logging, fetching, data serving, filing, measuring, notifying, queueing, scheduling, searching, workflow, and working services.",
  "keywords": [
    "nodejs",
    "backend",
    "services",
    "microservices",
    "cache",
    "logging",
    "queue",
    "workflow",
    "express"
  ],
  "files": [
    "src",
    "README.md",
    "package.json",
    "index.js"
  ],
  "license": "ISC",
  "author": "NooblyJS Contributors",
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": " https://github.com/nooblyjs/nooblyjs-core.git"
  },
  "scripts": {
    "clean": "rimraf node_modules dist",
    "build": "node ./scripts/build.js",
    "start": "node ./app.js",
    "dev": "nodemon --watch ./src ./app.js",
    "dev:noauth": "nodemon --watch ./src ./app-noauth.js",
    "tests": "jest",
    "test": "jest",
    "kill": "node scripts/kill-port.js",
    "kill-test": "node scripts/kill-test-port.js",
    "certs": "node scripts/generate-certs.js",
    "certs:force": "node scripts/generate-certs.js --force"
  },
  "jest": {
    "modulePaths": [
      "./"
    ],
    "transform": {},
    "forceExit": true,
    "detectOpenHandles": true
  },
  "overrides": {
    "uuid": "$uuid",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.2",
    "jest": "^30.0.3",
    "knip": "^6.12.2",
    "nock": "^13.5.6",
    "selfsigned": "^5.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@aws-sdk/client-s3": "^3.614.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@google-cloud/storage": "^5.18.3",
    "@google-cloud/tasks": "^6.2.2",
    "amqplib": "^0.10.9",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "ftp": "^0.3.10",
    "helmet": "^8.2.0",
    "ioredis": "^5.6.1",
    "ioredis-mock": "^8.9.0",
    "memjs": "^1.3.0",
    "mongodb": "^6.19.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "openai": "^5.23.2",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.4",
    "rimraf": "^6.0.1",
    "simple-git": "^3.28.0",
    "stompit": "^1.0.0",
    "supertest": "^7.1.4",
    "uuid": "^11.1.0"
  },
  "allowScripts": {
    "dtrace-provider@0.8.8": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.11.1": true
  }
}
