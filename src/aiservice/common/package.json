{
  "name": "nooblyjs-ai-common",
  "version": "0.1.0",
  "private": true,
  "description": "The NooblyJS AI module: one way to call every model provider (including AWS Bedrock, Google Vertex AI and Azure), the model catalogue, tokens, cost, retry, SSE and front matter. It lives inside nooblyjs-core; this file marks the folder as ESM and lets projects link it as a file: dependency",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cost": "./cost.js",
    "./discovery": "./discovery.js",
    "./errors": "./errors.js",
    "./frontmatter": "./frontmatter.js",
    "./models": "./models.js",
    "./providers": "./providers/index.js",
    "./providers/anthropic": "./providers/anthropic.js",
    "./providers/aws-eventstream": "./providers/aws-eventstream.js",
    "./providers/aws-sigv4": "./providers/aws-sigv4.js",
    "./providers/azure": "./providers/azure.js",
    "./providers/bedrock": "./providers/bedrock.js",
    "./providers/cache": "./providers/cache.js",
    "./providers/events": "./providers/events.js",
    "./providers/google-auth": "./providers/google-auth.js",
    "./providers/images": "./providers/images.js",
    "./providers/mock": "./providers/mock.js",
    "./providers/openai-compatible": "./providers/openai-compatible.js",
    "./providers/openai-responses": "./providers/openai-responses.js",
    "./providers/vertex": "./providers/vertex.js",
    "./retry": "./retry.js",
    "./sse": "./sse.js",
    "./tokens": "./tokens.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
